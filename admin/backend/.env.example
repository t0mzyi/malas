# ============================================================
# MALAS ELECTRONICS LLC — DATABASE & SERVER CONFIGURATION
# ============================================================

# Database Engine Mode:
# - 'sqlite': Instant local development (embedded zero-install database)
# - 'mariadb': Production remote MariaDB 10.6.28 instance
DB_CLIENT=sqlite

# MariaDB Connection Settings (Used when DB_CLIENT=mariadb)
DB_HOST=host7.cloudindianserver.com
DB_PORT=3306
DB_USER=malasele_db
DB_PASSWORD=
DB_NAME=malasele_db

# Admin Server Settings
PORT=5000
NODE_ENV=development

# JWT Secret for Protected Admin Sessions
JWT_SECRET=malas_admin_jwt_secret_token_replace_with_random_string_2026

# Default Initial Admin Seed Credentials
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_EMAIL=admin@malaselectronics.com
DEFAULT_ADMIN_PASSWORD=Admin@Malas2026!
