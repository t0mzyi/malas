# ============================================================
# MALAS ELECTRONICS LLC — BACKEND (RENDER + SUPABASE) CONFIG
# ============================================================

# Server Port (Render automatically sets PORT)
PORT=5000
NODE_ENV=production

# Database Client: 'supabase' (or 'postgres'), 'sqlite' (local dev), 'mariadb'
DB_CLIENT=supabase

# Supabase PostgreSQL Connection String (Found in Supabase: Project Settings -> Database -> Connection string -> URI)
# Example: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres

# CORS Allowed Origins (Comma-separated list of front-end domains)
CORS_ORIGIN=https://malaselectronics.co,https://www.malaselectronics.co,https://admin.malaselectronics.co

# JWT Secret for Protected Admin Sessions
JWT_SECRET=malas_admin_jwt_secret_token_replace_with_random_string_2026

# Cloudinary (Used for hardware product image uploads)
CLOUDINARY_CLOUD_NAME=jfxqts4x
CLOUDINARY_API_KEY=872827862522122
CLOUDINARY_API_SECRET=LLSp75tA57bVwQ_5hIWoXdANPJE
